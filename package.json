{
  "name": "@aura-studio/dynamic-node",
  "version": "0.1.0",
  "description": "Node.js runtime library for dynamically loading plugin packages from S3, counterpart of github.com/aura-studio/dynamic",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "dynamic",
    "plugin",
    "loader",
    "s3",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aura-studio/dynamic-node.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.6",
    "@types/node": "^20.17.0",
    "typescript": "^5.7.0",
    "vitest": "^1.6.0"
  }
}
