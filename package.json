{
  "name": "@aura-studio/dynamic-node",
  "version": "0.2.0",
  "description": "Node.js runtime library for dynamically loading plugin packages from S3",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:examples": "node examples/scripts/99-run-all-local.js",
    "test:examples:s3": "node examples/scripts/99-run-all-with-s3.js",
    "test:examples:s3:docker": "node examples/scripts/99-run-all-docker-s3.js",
    "examples:web": "node examples/scripts/test-ui.js",
    "test:all": "npm test && npm run test:examples"
  },
  "keywords": [
    "dynamic",
    "plugin",
    "loader",
    "s3",
    "runtime"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aura-studio/dynamic-node.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "vitest": "^1.6.0"
  }
}
